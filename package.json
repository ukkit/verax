{
  "name": "verax",
  "version": "0.1790733000.0",
  "private": true,
  "description": "Free, privacy-first mutual fund portfolio tracker for India. Import your CAMS or KFintech CAS PDF and get live NAV valuation, XIRR, gain and NAV charts. Runs entirely in your browser, with no account and no upload.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "vite build",
    "build:server": "esbuild server/local.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist-server/local.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "start": "node dist-server/local.mjs",
    "scan": "node scripts/scan-pii.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@vercel/functions": "3.9.9",
    "pdfjs-dist": "6.3.289",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
